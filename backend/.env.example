# Database Configuration (AWS RDS PostgreSQL example)
DATABASE_URL=postgresql://user:password@your-rds-endpoint.amazonaws.com:5432/grocery_db

# For local development with SQLite (uncomment to use)
# DATABASE_URL=sqlite:///./grocery.db

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App Configuration
APP_NAME=Gro-Cart
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS Configuration (if using DynamoDB or S3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
